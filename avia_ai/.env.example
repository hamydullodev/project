# ==============================================================================
# AI Travel Agent — Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# Never commit the real `.env` file — it is already listed in .gitignore.
# ==============================================================================

# --- Application ---------------------------------------------------------
APP_NAME="Avia AI"
APP_ENV=development          # development | production
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- Local LLM (Ollama) ---------------------------------------------------
# Cloud LLM providers (OpenAI, Anthropic, Gemini) are intentionally NOT
# supported in this project. Everything runs on a locally hosted model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_TEMPERATURE=0.3
OLLAMA_REQUEST_TIMEOUT_SECONDS=60

# --- Speech-to-Text (local Whisper, no cloud API) ---------------------------
# Model size: tiny | base | small | medium | large-v3. Bigger = more accurate,
# slower, more RAM. Weights download once on first use.
WHISPER_MODEL_SIZE=small
WHISPER_LANGUAGE=uz

# --- Flight Data Provider ---------------------------------------------------
# Choose ONE provider and set FLIGHT_DATA_PROVIDER accordingly.
FLIGHT_DATA_PROVIDER=amadeus   # amadeus | kiwi | aviationstack

AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

KIWI_TEQUILA_API_KEY=

AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1

# --- Airport / Places Search (Geoapify) -----------------------------------
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com

# --- Currency Exchange -------------------------------------------------------
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6

# --- Weather (bonus feature) ---------------------------------------------
OPENWEATHER_API_KEY=

# --- Web Search (bonus feature) -------------------------------------------
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev

# --- Caching -----------------------------------------------------------------
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=256

# --- Networking / Retry Policy ------------------------------------------------
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=1.5
HTTP_TIMEOUT_SECONDS=15
