# ============================================================================
# Hybrid RAG configuration — copy this file to `.env` and adjust as needed.
# Every value here has a sane default baked into app/config/settings.py,
# so `.env` only needs to contain the values you want to OVERRIDE.
# ============================================================================

# --- Local LLM (served by Ollama) -------------------------------------------
# Run `ollama list` to see models you already have pulled locally.
# Any locally-served chat model works: llama3.2, qwen2.5, mistral, gemma2, deepseek-r1 ...
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Embedding model (dense retrieval) --------------------------------------
# Must be a sentence-embedding model with decent Uzbek/multilingual coverage.
# Default is a small (~470MB) multilingual model chosen for reliability on
# machines with limited RAM. For better retrieval quality on a machine with
# more headroom (16GB+ RAM recommended), switch to:
#   BAAI/bge-m3                        (~2.3GB, no query prefix needed)
#   intfloat/multilingual-e5-large     (~2.2GB, requires query/passage prefixes
#                                        - handled automatically either way)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=auto

# --- Reranker model (cross-encoder) -----------------------------------------
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=auto

# --- Chunking -----------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# character = raw character count; token = approximate whitespace/punctuation token count
CHUNKING_STRATEGY=character

# --- Retrieval ------------------------------------------------------------------
# TOP_K: how many candidates each of dense/sparse search returns before fusion.
# RERANK_TOP_K: how many fused candidates survive reranking and reach the LLM.
TOP_K=20
RERANK_TOP_K=5
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5

# --- Query preprocessing & context compression --------------------------------
MAX_QUERY_LENGTH=1000
MAX_CONTEXT_CHARS=6000
CONTEXT_SIMILARITY_THRESHOLD=0.6

# --- Storage paths (relative to the project root unless absolute) -----------
VECTOR_PATH=indexes/faiss_index
BM25_PATH=indexes/bm25_index.pkl
SQLITE_PATH=data/metadata.db
DOCUMENTS_PATH=documents

# --- Logging --------------------------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=INFO
